{
  "name": "@yumine9/vue3-tiptap",
  "version": "1.1.5",
  "type": "module",
  "description": "Ready-made UI for TipTap in Vue 3 — themeable rich text editor with an auto-collected toolbar, bubble menus and i18n.",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "import": "./dist/ai.js",
      "require": "./dist/ai.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "vue",
    "vue3",
    "tiptap",
    "rich-text",
    "editor",
    "wysiwyg",
    "ui",
    "themeable",
    "toolbar"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "prepublishOnly": "pnpm build:lib",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "vue": "^3.5.13"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-audio": "^3.32.0",
    "@tiptap/extension-blockquote": "^3.32.0",
    "@tiptap/extension-bold": "^3.32.0",
    "@tiptap/extension-code": "^3.32.0",
    "@tiptap/extension-code-block": "^3.32.0",
    "@tiptap/extension-collaboration": "^3.32.0",
    "@tiptap/extension-details": "^3.32.0",
    "@tiptap/extension-document": "^3.32.0",
    "@tiptap/extension-drag-handle": "^3.32.0",
    "@tiptap/extension-file-handler": "^3.32.0",
    "@tiptap/extension-find-and-replace": "^3.32.0",
    "@tiptap/extension-hard-break": "^3.32.0",
    "@tiptap/extension-heading": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-horizontal-rule": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-invisible-characters": "^3.32.0",
    "@tiptap/extension-italic": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-mention": "^3.32.0",
    "@tiptap/extension-node-range": "^3.32.0",
    "@tiptap/extension-paragraph": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-strike": "^3.32.0",
    "@tiptap/extension-subscript": "^3.32.0",
    "@tiptap/extension-superscript": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extension-typography": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "@tiptap/vue-3": "^3.32.0",
    "@tiptap/y-tiptap": "^3.0.10",
    "marked": "^17.0.6"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.149",
    "@iconify-json/tabler": "^1.2.38",
    "@microsoft/api-extractor": "^7.59.4",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^20.11.2",
    "prettier": "^3.9.8",
    "sass": "^1.102.0",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-dts": "^1.1.2",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.0.12",
    "vitest": "^5.0.1",
    "vue": "^3.5.34",
    "vue-tsc": "^3.2.8"
  },
  "sideEffects": [
    "*.css"
  ]
}
